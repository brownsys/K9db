# Default exclusions, which keep the build context for Dockerfile.release
# small. The dev image opts out of most of these via its own
# Dockerfile.dev.dockerignore: BuildKit uses <dockerfile>.dockerignore in
# preference to this file.
.git
bazel-*
user.bazelrc
experiments
Dockerfile*
# Prebuilt proxy binary at the repo root (not part of the source tree).
proxy
